NODE_ENV=production
DOMAIN_API=api.onusclub.com
DOMAIN_WEB=app.onusclub.com

# --- MySQL ---
# Generate with: openssl rand -hex 24
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=stampdeck
MYSQL_USER=stampdeck
MYSQL_PASSWORD=
# Read-only user for n8n + Metabase dashboards. Different password from above.
REPORTING_PASSWORD=

# --- API secrets ---
# Generate with: openssl rand -hex 32
JWT_SECRET=
# NextAuth secret (used by apps/web — even though we don't yet use NextAuth,
# the framework still expects this in production builds).
NEXTAUTH_SECRET=

# --- Google Wallet ---
GOOGLE_WALLET_ISSUER_ID=3388000000023150410

# --- Resend (transactional email) ---
RESEND_API_KEY=
# MUST be quoted. The display-name form contains < and >, which are shell
# redirection operators — an unquoted value here makes `set -a; . ./.env`
# die with "syntax error near unexpected token `newline'", silently leaving
# every variable BELOW this line unset. Docker Compose parses .env with its
# own parser and is unaffected, so the breakage only shows up in shell
# scripts such as scripts/verify-deploy.sh.
EMAIL_FROM="OnUsClub <noreply@send.onusclub.com>"
