NODE_ENV=production
DOMAIN_API=api.sippzy.com
DOMAIN_WEB=app.sippzy.com

# --- MySQL ---
# Generate with: openssl rand -hex 24
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=stampdeck
MYSQL_USER=stampdeck
MYSQL_PASSWORD=
# Read-only user for n8n + Metabase dashboards. Different password from above.
REPORTING_PASSWORD=

# --- API secrets ---
# Generate with: openssl rand -hex 32
JWT_SECRET=
# NextAuth secret (used by apps/web — even though we don't yet use NextAuth,
# the framework still expects this in production builds).
NEXTAUTH_SECRET=

# --- Google Wallet ---
GOOGLE_WALLET_ISSUER_ID=3388000000023150410

# --- Resend (transactional email) ---
RESEND_API_KEY=
# Once you've verified sippzy.com in Resend, change this to e.g.
# "Stampdeck <noreply@sippzy.com>". Leave default until verification.
EMAIL_FROM=Stampdeck <onboarding@resend.dev>
