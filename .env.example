NODE_ENV=production
DOMAIN_API=api.onusclub.com
DOMAIN_WEB=app.onusclub.com

# --- MySQL ---
# Generate with: openssl rand -hex 24
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=stampdeck
MYSQL_USER=stampdeck
MYSQL_PASSWORD=
# Read-only user for n8n + Metabase dashboards. Different password from above.
REPORTING_PASSWORD=

# --- API secrets ---
# Generate with: openssl rand -hex 32
# At least 32 characters — the signing key for every session token.
# Generate with: openssl rand -base64 48
JWT_SECRET=
# NextAuth secret (used by apps/web — even though we don't yet use NextAuth,
# the framework still expects this in production builds).
NEXTAUTH_SECRET=

# --- Google Wallet ---
GOOGLE_WALLET_ISSUER_ID=3388000000023150410

# --- Resend (transactional email) ---
RESEND_API_KEY=
# MUST be quoted. The display-name form contains < and >, which are shell
# redirection operators — an unquoted value here makes `set -a; . ./.env`
# die with "syntax error near unexpected token `newline'", silently leaving
# every variable BELOW this line unset. Docker Compose parses .env with its
# own parser and is unaffected, so the breakage only shows up in shell
# scripts such as scripts/verify-deploy.sh.
EMAIL_FROM="OnUsClub <noreply@send.onusclub.com>"

# --- Anthropic (AI campaign drafts) ---
# Empty → POST /v1/broadcasts/drafts answers 503 "ai_not_configured" and the
# dashboard hides the Draft button entirely. The api still boots.
#
# This is OUR key paying OUR bill, not the merchant's, so the endpoint is
# premium-gated and capped at 20 drafts per hour per merchant. Every call is
# recorded in `ai_drafts` with its token counts — if the Anthropic invoice ever
# looks wrong, that table is where the answer is.
ANTHROPIC_API_KEY=

# --- Sign in with Google ---
# Empty → the Google endpoints answer 503 and no button renders. Both apps
# still boot.
#
# NOT a secret: an OAuth client ID ships in the page HTML by design, and the
# ID-token flow never uses the client *secret* at all — there is no redirect.
#
# 🚨 There is deliberately no NEXT_PUBLIC_ twin. Next inlines NEXT_PUBLIC_*
# into client bundles at BUILD time while compose supplies env at RUNTIME, so
# a client component reading one would be an empty string in production with
# this file looking perfectly correct. The server passes it down as a prop.
#
# Get it from: Google Cloud console → APIs & Services → Credentials → OAuth
# client ID → Web application, with https://app.onusclub.com and
# http://localhost:3001 as Authorized JavaScript origins. The OAuth consent
# screen must be "In production", not "Testing", or only allowlisted Google
# accounts can sign in. Ends in .apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_ID=

# --- Marketing-site lead capture ---
# Shared secret the onusclub.com server presents on POST /v1/public/leads.
# EMPTY MEANS THE ENDPOINT IS CLOSED (503), which is the safe default: this is
# the only unauthenticated write surface in the api and there is no rate
# limiting anywhere. Generate with: openssl rand -hex 32
LEADS_INGEST_SECRET=
# Where new-lead notifications go. A lead nobody sees is a lead discarded.
LEADS_NOTIFY_EMAIL=onusclub.official@gmail.com

# --- Trials ---
# Trial length in days for NEW signups. Per-merchant overrides live in
# merchants.trial_ends_at; this only decides what a fresh signup gets.
# 0 disables trials — new merchants are created with no clock at all.
TRIAL_DAYS_DEFAULT=14
