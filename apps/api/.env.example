PORT=4000
DATABASE_URL=mysql://stampdeck:stampdeck_dev_pass@mysql:3306/stampdeck
# --- Google Wallet ---
# DISABLED BY DEFAULT ON PURPOSE. These defaults mirror CI.
#
# There is exactly one issuer (3388000000023150410) and it is the production
# one. Point local dev at it and every `pnpm smoke` run creates real
# LoyaltyClasses on it — which is how ~40 classes named "Smoke Café
# <timestamp>" ended up permanently on the live issuer. Permanently, because
# the Google Wallet API has **no delete operation** for classes: insert, get,
# patch, update, list, addmessage, and that is all.
#
# With these values the api reports "wallet not configured" and every Google
# Wallet path degrades gracefully — exactly what CI exercises. Apple Wallet is
# unaffected and is the wallet worth testing locally anyway.
#
# To deliberately test Google Wallet locally, set the real issuer id and point
# the key path at a mounted service-account key — then set them back.
GOOGLE_WALLET_ISSUER_ID=0
GOOGLE_WALLET_SA_KEY_PATH=/tmp/nonexistent.json
JWT_SECRET=change_me_in_prod
BASE_URL_WEB=http://localhost:3001
BASE_URL_API=http://localhost:4000

# Resend (transactional email). Leave RESEND_API_KEY blank to fall back to
# logging the email body to console — useful in CI / smoke tests.
RESEND_API_KEY=
# Quoted: the display-name form contains < and >, which are shell redirection
# operators if anything ever sources this file. See .env.example at the repo root.
EMAIL_FROM="OnUsClub <onboarding@resend.dev>"

# --- Apple Wallet ---
# Leave APPLE_PASS_P12_PASSWORD blank in any environment without the cert
# (api falls back to "Apple Wallet not configured" responses). Path values
# point into /secrets/apple/ which is mounted by docker-compose.
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=pass.com.onusclub.loyalty
APPLE_PASS_P12_PATH=/secrets/apple/onusclub-pass.p12
APPLE_PASS_P12_PASSWORD=
APPLE_WWDR_PATH=/secrets/apple/AppleWWDRCAG4.pem

# Apple Wallet live updates (Day 12). Push certificate from Apple Developer's
# Pass Type ID detail page (different from the pass signing cert above). Leave
# blank to disable live updates — passes still download but won't auto-update.
APPLE_APNS_P12_PATH=/secrets/apple/onusclub-push.p12
APPLE_APNS_P12_PASSWORD=

# --- Marketing-site lead capture ---
# Empty → POST /v1/public/leads returns 503 and stores nothing (safe default).
LEADS_INGEST_SECRET=
LEADS_NOTIFY_EMAIL=onusclub.official@gmail.com

# --- Trials ---
# Trial length in days for NEW signups. Per-merchant overrides live in
# merchants.trial_ends_at; this only decides what a fresh signup gets.
# 0 disables trials — new merchants are created with no clock at all.
TRIAL_DAYS_DEFAULT=14
